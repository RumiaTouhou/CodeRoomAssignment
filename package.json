{
  "name": "coderoom",
  "private": true,
  "type": "module",
  "description": "Real-time text and code collaboration",
  "workspaces": [
    "client"
  ],
  "engines": {
    "node": ">=22.13"
  },
  "scripts": {
    "dev": "node --import tsx scripts/dev.ts",
    "build": "npm run build --workspace=client && tsc -p server/tsconfig.json",
    "start": "node dist/server/index.js",
    "typecheck": "tsc -p tsconfig.json",
    "test": "node scripts/test.mjs && node tests/ui.test.mjs",
    "test:ui": "node tests/ui.test.mjs",
    "build:preview": "npm run build:preview --workspace=client",
    "preview": "npm run preview --workspace=client",
    "build:client": "npm run build --workspace=client",
    "test:browser": "playwright test",
    "test:release": "node --test tests/release.test.mjs"
  },
  "dependencies": {
    "ws": "8.22.0"
  },
  "devDependencies": {
    "@types/node": "^22.15.0",
    "@types/ws": "^8.18.1",
    "esbuild": "0.25.12",
    "jsdom": "26.1.0",
    "tsx": "^4.20.0",
    "typescript": "^5.8.3",
    "@types/jsdom": "^21.1.7",
    "@playwright/test": "1.64.1"
  }
}
